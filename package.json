{
  "name": "bd-phone-validator",
  "version": "1.0.0",
  "description": "Validate, normalize, format and mask Bangladeshi phone numbers. Mobile operator detection, landline and hotline categories, Bangla digits, bulk cleaning and a CLI. Zero dependencies.",
  "keywords": [
    "bangladesh",
    "bd",
    "phone",
    "phone-number",
    "mobile",
    "validator",
    "validation",
    "normalize",
    "e164",
    "operator",
    "grameenphone",
    "banglalink",
    "robi",
    "teletalk",
    "bangla",
    "typescript"
  ],
  "author": "Saizul Amin <hello@saizul.com> (https://saizul.com)",
  "license": "MIT",
  "homepage": "https://saizul.com",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bd-phone": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
